@@ -0,0 +1,178 @@
+// Tests for the attendance core, built from the worked examples in the document.
+
+import { describe, expect, it } from 'vitest'
+import type { AppData } from '../data/model'
+import { EMPTY_DATA } from '../data/model'
+import type { Subject } from '../data/model'
+import {
+  buildReport,
+  computeSubjectTotals,
+  slotsForDate,
+  summarizeSubject,
+} from './attendance'
+
+function dataWith(over: Partial<AppData>): AppData {
+  return { ...structuredClone(EMPTY_DATA), ...over }
+}
+
+describe('B4/B5 formulas (threshold 75)', () => {
+  function summary(attended: number, held: number, threshold = 75) {
+    const subj: Subject = { id: 's1', shortName: 'X', fullName: 'X', nicknames: [], typedAttended: attended, typedHeld: held }
+    const data = dataWith({ subjects: [subj] })
+    data.settings.threshold = threshold
+    const totals = computeSubjectTotals(data, 's1', '2026-01-01', '2026-01-01', '2026-01-01')
+    return summarizeSubject(data, 's1', totals)
+  }
+
+  it('can miss N = floor((100A − min·H)/min): 80/100 at 75 → can miss 33', () => {
+    const s = summary(80, 100)
+    expect(s.canMiss).toBe(Math.floor((100 * 80 - 75 * 100) / 75)) // 6
+    expect(s.canMiss).toBe(6)
+    expect(s.status).toBe('safe')
+    expect(s.message).toContain('You’re safe! You can skip 6 more classes')
+  })
+
+  it('exactly at the limit shows the limit message', () => {
+    const s = summary(75, 100)
+    expect(s.canMiss).toBe(0)
+    expect(s.status).toBe('limit')
+    expect(s.message).toBe('At the limit. Don’t miss the next class')
+  })
+
+  it('below minimum: attend next N classes (ceil formula)', () => {
+    // 70 of 100 at 75%: need ceil((75*100 − 100*70)/(100−75)) = ceil(500/25) = 20
+    const s = summary(70, 100)
+    expect(s.status).toBe('below')
+    expect(s.mustAttendNext).toBe(20)
+    expect(s.message).toBe('Attend the next 20 classes to get back to 75%')
+  })
+
+  it('threshold 100 below is out of reach', () => {
+    const s = summary(99, 100, 100)
+    expect(s.status).toBe('below')
+    expect(s.message).toContain('cannot be recovered')
+  })
+
+  it('changing the threshold changes every can-miss number (F1)', () => {
+    expect(summary(80, 100, 75).canMiss).toBe(6)
+    expect(summary(80, 100, 80).canMiss).toBe(0)
+    expect(summary(80, 100, 80).status).toBe('limit')
+    expect(summary(80, 100, 90).status).toBe('below')
+  })
+})
+
+describe('J5 assumed past attendance + B2 no-class', () => {
+  it('past unmarked classes count at assumed %, marked ones leave the pool', () => {
+    // One Mon class per week; semester start Mon 2026-10-05, today Fri 2026-10-23.
+    // Mondays before today: 5,12,19 = 3 past classes. Assume 80% → round(2.4)=2 attended.
+    const data = dataWith({
+      subjects: [{ id: 's1', shortName: 'X', fullName: 'X', nicknames: [] }],
+      slots: [
+        {
+          id: 'sl1', subjectId: 's1', weekday: 1, startTime: '09:00', endTime: '10:00',
+          type: 'lecture', room: '', teacher: '', validFrom: '2026-10-05', validUntil: null,
+        },
+      ],
+    })
+    data.settings.semesterStart = '2026-10-05'
+    const t = computeSubjectTotals(data, 's1', '2026-10-05', '2026-10-23', '2026-10-23')
+    expect(t.held).toBe(3)
+    expect(t.attended).toBe(2) // round(0.8 × 3) = 2
+
+    // Mark one past Monday absent: pool becomes 2 unmarked → round(1.6)=2, plus 0 marked present.
+    data.marks.push({ id: 'm1', date: '2026-10-12', slotId: 'sl1', status: 'absent' })
+    const t2 = computeSubjectTotals(data, 's1', '2026-10-05', '2026-10-23', '2026-10-23')
+    expect(t2.held).toBe(3)
+    expect(t2.attended).toBe(2) // round(0.8×2)=2
+
+    // No class counts in neither (B2).
+    data.marks[0].status = 'noclass'
+    const t3 = computeSubjectTotals(data, 's1', '2026-10-05', '2026-10-23', '2026-10-23')
+    expect(t3.held).toBe(2)
+    expect(t3.attended).toBe(2) // round(0.8×2)… wait pool: 5th and 19th unmarked past = 2 → attended 2? 
+    // Actually both remaining are unmarked past: round(0.8*2)=2? 0.8*2=1.6→2. Yes.
+  })
+
+  it('worked example J13 row: 60 past unmarked at 80% → 48 attended of 60 held', () => {
+    // Simulate with typed-free math: 60 Mondays over ~15 months is slow; instead check the rounding directly.
+    const data = dataWith({
+      subjects: [{ id: 's1', shortName: 'X', fullName: 'X', nicknames: [] }],
+      slots: [
+        {
+          id: 'sl1', subjectId: 's1', weekday: 1, startTime: '09:00', endTime: '10:00',
+          type: 'lecture', room: '', teacher: '', validFrom: '2026-08-03', validUntil: null,
+        },
+      ],
+    })
+    // Aug 3 (Mon) .. Oct 26 (Mon) = 13 Mondays past, today Wed Oct 28.
+    const t = computeSubjectTotals(data, 's1', '2026-08-03', '2026-10-28', '2026-10-28')
+    expect(t.held).toBe(13)
+    expect(t.attended).toBe(Math.round(0.8 * 13)) // 10 (0.8*13=10.4→10)
+  })
+
+  it('B8/J6: typed ERP totals replace calculated figures', () => {
+    const data = dataWith({
+      subjects: [{ id: 's1', shortName: 'X', fullName: 'X', nicknames: [], typedAttended: 30, typedHeld: 60 }],
+      slots: [
+        {
+          id: 'sl1', subjectId: 's1', weekday: 1, startTime: '09:00', endTime: '10:00',
+          type: 'lecture', room: '', teacher: '', validFrom: '2026-08-03', validUntil: null,
+        },
+      ],
+    })
+    const t = computeSubjectTotals(data, 's1', '2026-08-03', '2026-10-28', '2026-10-28')
+    expect(t.held).toBe(60)
+    expect(t.attended).toBe(30)
+    expect(t.usesTypedTotals).toBe(true)
+  })
+})
+
+describe('A7/A8 weekly repeat and history', () => {
+  const base = {
+    id: 'sl1', subjectId: 's1', weekday: 1, startTime: '09:00', endTime: '10:00',
+    type: 'lecture' as const, room: '', teacher: '',
+  }
+
+  it('a Monday slot appears on every Monday after validFrom', () => {
+    const data = dataWith({
+      subjects: [{ id: 's1', shortName: 'X', fullName: 'X', nicknames: [] }],
+      slots: [{ ...base, validFrom: '2026-10-05', validUntil: null }],
+    })
+    expect(slotsForDate(data, '2026-10-05')).toHaveLength(1) // Mon
+    expect(slotsForDate(data, '2026-10-12')).toHaveLength(1) // next Mon
+    expect(slotsForDate(data, '2026-10-06')).toHaveLength(0) // Tue
+  })
+
+  it('removing from today keeps past days intact (validUntil)', () => {
+    const data = dataWith({
+      subjects: [{ id: 's1', shortName: 'X', fullName: 'X', nicknames: [] }],
+      slots: [{ ...base, validFrom: '2026-10-05', validUntil: '2026-10-26' }],
+    })
+    expect(slotsForDate(data, '2026-10-19')).toHaveLength(1) // before removal — still there
+    expect(slotsForDate(data, '2026-11-02')).toHaveLength(0) // after — gone
+  })
+
+  it('Sunday off by default, on when enabled (A13)', () => {
+    const data = dataWith({
+      subjects: [{ id: 's1', shortName: 'X', fullName: 'X', nicknames: [] }],
+      slots: [{ ...base, weekday: 7, validFrom: '2026-10-01', validUntil: null }],
+    })
+    expect(slotsForDate(data, '2026-10-04')).toHaveLength(0) // Sunday
+    data.settings.sundayClasses = true
+    expect(slotsForDate(data, '2026-10-04')).toHaveLength(1)
+  })
+
+  it('holidays remove classes but exam days keep them (A12, J3)', () => {
+    const data = dataWith({
+      subjects: [{ id: 's1', shortName: 'X', fullName: 'X', nicknames: [] }],
+      slots: [{ ...base, validFrom: '2026-10-05', validUntil: null }],
+      holidays: [
+        { id: 'h1', startDate: '2026-10-12', endDate: '2026-10-12', label: 'Holiday', isExamDay: false },
+        { id: 'h2', startDate: '2026-10-19', endDate: '2026-10-19', label: 'Exam', isExamDay: true },
+      ],
+    })
+    const r = buildReport(data, '2026-10-23', '2026-10-05', '2026-10-23')
+    // Past Mondays: 5, 12 (holiday, excluded), 19 (exam day, counts) → held 2
+    expect(r.bySubject[0].held).toBe(2)
+  })
+})
diff --git a/app/src/logic/attendance.ts b/app/src/logic/attendance.ts
new file mode 100644
index 0000000..7ea37c5
--- /dev/null
+++ b/app/src/logic/attendance.ts
@@ -0,0 +1,234 @@
+// ============================================================
+// Attendance core — plain code on the phone, fixed formulas.
+// B2:  percentage = attended ÷ held × 100; No class counts in neither.
+// B4:  can miss N = floor((100×attended − min×held) ÷ min)
+// B5:  back to X%: N = ceil((min×held − 100×attended) ÷ (100 − min))
+// J4/J5: past unmarked classes count at the assumed % (rounded to
+//        nearest whole class); marked ones are exact and leave the
+//        assumed pool. B8/J6: typed totals replace everything.
+// Data rules: attended ≤ held, both ≥ 0; timetable edits apply from
+//        their validFrom onward (past days keep what they had).
+// ============================================================
+
+import type { AppData, DateStr, MarkStatus, Slot, Subject } from '../data/model'
+import { addDays, weekdayOf } from './dates'
+
+/** Slots that were scheduled on a given date, honouring validFrom/validUntil (A8)
+ *  and Sunday off unless enabled (A13). */
+export function slotsForDate(data: AppData, date: DateStr): Slot[] {
+  const wd = weekdayOf(date)
+  if (wd === 7 && !data.settings.sundayClasses) return []
+  return data.slots.filter(
+    (s) =>
+      s.weekday === wd &&
+      date >= s.validFrom &&
+      (s.validUntil === null || date <= s.validUntil),
+  )
+}
+
+/** True when the date falls inside a holiday range (A12). Exam days DO count
+ *  as normal classes (section J), so isExamDay holidays are not no-class days. */
+export function isHoliday(data: AppData, date: DateStr): boolean {
+  return data.holidays.some(
+    (h) => !h.isExamDay && date >= h.startDate && date <= h.endDate,
+  )
+}
+
+export function markFor(data: AppData, date: DateStr, slotId: string): MarkStatus | null {
+  const m = data.marks.find((mk) => mk.date === date && mk.slotId === slotId)
+  return m ? m.status : null
+}
+
+/** All dates from `from` up to and including `to`. */
+export function eachDay(from: DateStr, to: DateStr): DateStr[] {
+  const out: DateStr[] = []
+  let d = from
+  while (d <= to) {
+    out.push(d)
+    d = addDays(d, 1)
+  }
+  return out
+}
+
+export interface SubjectTotals {
+  subjectId: string
+  /** Classes counted as held (No class excluded). */
+  held: number
+  /** Classes attended. */
+  attended: number
+  /** Held classes with no mark yet that fall before today (assumed pool). */
+  unmarkedPast: number
+  /** Whether B8 typed totals were used. */
+  usesTypedTotals: boolean
+}
+
+/**
+ * Compute held/attended for one subject over a date range.
+ * - Marks inside the range are counted exactly.
+ * - Past (before `today`) unmarked scheduled classes count toward held, and
+ *   contribute round(assumed% × count) attended (J5) — unless the subject has
+ *   typed ERP totals, which replace all of it (B8/J6).
+ * - Future unmarked classes are not counted at all.
+ */
+export function computeSubjectTotals(
+  data: AppData,
+  subjectId: string,
+  rangeStart: DateStr,
+  rangeEnd: DateStr,
+  today: DateStr,
+): SubjectTotals {
+  const subj = data.subjects.find((s) => s.id === subjectId)
+  let held = 0
+  let attended = 0
+  let unmarkedPast = 0
+
+  for (const date of eachDay(rangeStart, rangeEnd)) {
+    if (isHoliday(data, date)) continue
+    for (const slot of slotsForDate(data, date)) {
+      if (slot.subjectId !== subjectId) continue
+      const status = markFor(data, date, slot.id)
+      if (status === 'noclass') continue // B2: counts in neither
+      held += 1
+      if (status === 'present') attended += 1
+      else if (status === 'absent') {
+        /* not attended */
+      } else {
+        // unmarked
+        if (date < today) unmarkedPast += 1
+        else if (data.settings.unmarkedAsPresent) attended += 1 // B14 (Stretch setting)
+      }
+    }
+  }
+
+  // J5: assumed attendance for past unmarked classes.
+  const assumedPct = data.settings.assumedPastAttendance
+  attended += Math.round((assumedPct / 100) * unmarkedPast)
+
+  const usesTyped = subj?.typedHeld !== undefined
+  if (usesTyped && subj) {
+    held = Math.max(0, subj.typedHeld ?? 0)
+    attended = Math.min(held, Math.max(0, subj.typedAttended ?? 0))
+  }
+
+  // Data rule: attended never exceeds held, neither below 0.
+  attended = Math.max(0, Math.min(attended, held))
+  held = Math.max(0, held)
+
+  return { subjectId, held, attended, unmarkedPast, usesTypedTotals: usesTyped }
+}
+
+export interface AttendanceSummary {
+  subjectId: string
+  name: string
+  shortName: string
+  held: number
+  attended: number
+  /** Percentage, unrounded value kept separately for maths. */
+  percent: number
+  threshold: number
+  status: 'safe' | 'limit' | 'below' | 'nodata'
+  /** Friendly line per B4/B5/B7. */
+  message: string
+  /** N in "you can miss N more classes"; 0 otherwise. */
+  canMiss: number
+  /** N in "attend the next N classes" (B5); only when below. */
+  mustAttendNext: number
+  /** Whether at least 5 classes are marked for this subject (B7 warning gate). */
+  enoughMarks: boolean
+}
+
+function effectiveThreshold(data: AppData, subject: Subject): number {
+  return subject.thresholdOverride ?? data.settings.threshold
+}
+
+export function summarizeSubject(
+  data: AppData,
+  subjectId: string,
+  totals: SubjectTotals,
+): AttendanceSummary {
+  const subject = data.subjects.find((s) => s.id === subjectId)!
+  const t = effectiveThreshold(data, subject)
+  const { held, attended } = totals
+  const percent = held === 0 ? 0 : (attended / held) * 100
+
+  // Count how many classes the user actually marked (for the B7 gate).
+  let markedCount = 0
+  for (const m of data.marks) {
+    const slot = data.slots.find((sl) => sl.id === m.slotId)
+    if (slot && slot.subjectId === subjectId && m.status !== 'noclass') markedCount += 1
+  }
+  const enoughMarks = totals.usesTypedTotals || markedCount >= 5
+
+  let status: AttendanceSummary['status'] = 'nodata'
+  let message = ''
+  let canMiss = 0
+  let mustAttendNext = 0
+
+  if (held === 0) {
+    message = 'No classes recorded yet.'
+  } else {
+    if (percent >= t) {
+      // B4: N = floor((100×A − min×H) ÷ min)
+      const n = Math.floor(((100 * attended - t * held) / t))
+      status = n === 0 ? 'limit' : 'safe'
+      if (n === 0) message = 'At the limit. Don\u2019t miss the next class'
+      else message = `You\u2019re safe! You can skip ${n} more class${n === 1 ? '' : 'es'}`
+      canMiss = Math.max(0, n)
+    } else {
+      status = 'below'
+      if (t >= 100) {
+        mustAttendNext = 0
+        message = `Below ${t}% and it cannot be recovered by attending alone.`
+      } else {
+        // B5: N = ceil((min×H − 100×A) ÷ (100 − min))
+        mustAttendNext = Math.ceil((t * held - 100 * attended) / (100 - t))
+        message = `Attend the next ${mustAttendNext} class${mustAttendNext === 1 ? '' : 'es'} to get back to ${t}%`
+      }
+    }
+  }
+
+  return {
+    subjectId,
+    name: subject.fullName,
+    shortName: subject.shortName,
+    held,
+    attended,
+    percent,
+    threshold: t,
+    status,
+    message,
+    canMiss,
+    mustAttendNext,
+    enoughMarks,
+  }
+}
+
+export function overallPercent(summaries: AttendanceSummary[]): number {
+  const held = summaries.reduce((a, s) => a + s.held, 0)
+  const attended = summaries.reduce((a, s) => a + s.attended, 0)
+  return held === 0 ? 0 : (attended / held) * 100
+}
+
+/** Everything the UI needs, recomputed from marks + timetable + settings.
+ *  Never stored (data model rule). */
+export interface AttendanceReport {
+  bySubject: AttendanceSummary[]
+  overall: number
+  /** Subjects below threshold with enough marks to warn (B7). */
+  warnings: AttendanceSummary[]
+}
+
+export function buildReport(
+  data: AppData,
+  today: DateStr,
+  rangeStart: DateStr,
+  rangeEnd: DateStr,
+): AttendanceReport {
+  const bySubject = data.subjects.map((subj) => {
+    const totals = computeSubjectTotals(data, subj.id, rangeStart, rangeEnd, today)
+    return summarizeSubject(data, subj.id, totals)
+  })
+  const overall = overallPercent(bySubject)
+  const warnings = bySubject.filter((s) => s.status === 'below' && s.enoughMarks)
+  return { bySubject, overall, warnings }
+}
